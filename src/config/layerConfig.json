{
    "layers": [
        {
            "id": "baseLayer",
            "layerParams": {
                "sourceId": "polygon-data-source",
                "fillLayerId": "polygon-fill-layer",
                "outlineLayerId": "polygon-outline-layer",
                "textLayerId": "polygon-text-layer"
            },
            "label":"行政区划",
            "visible": true,
            "zIndex": 0,
            "apiName": "getAreaByName",
            "clickable": true
        },
        {
            "id": "fieldLayer",
            "type": "thematicLayer",
            "layerParams": {
                "sourceId": "field-data-source",
                "fillLayerId": "field-fill-layer",
                "outlineLayerId": "field-outline-layer"
            },
            "label":"勾勒地块",
            "layerStyle": {
                "fillLayerStyle": {
                    "fill-color": "#ffffe0",
                    "fill-opacity": 0.2
                },
                "outlineLayerStyle": {
                    "line-color": "#ffe88c",
                    "line-width": [
                        "case",
                        [
                            "boolean",
                            [
                                "feature-state",
                                "highlighted"
                            ],
                            false
                        ],
                        3,
                        1
                    ],
                    "line-opacity": 1
                }
            },
            "visible": false,
            "zIndex": 1,
            "apiName": "getFieldByName",
            "clickable": false
        },
        {
            "id": "contractLayer",
            "type": "thematicLayer",
            "layerParams": {
                "sourceId": "contract-data-source",
                "fillLayerId": "contract-fill-layer",
                "outlineLayerId": "contract-outline-layer"
            },
            "label":"耘智保地块",
            "layerStyle": {
                "fillLayerStyle": {
                    "fill-color": [
                        "match",
                        [
                            "get",
                            "zs"
                        ],
                        1,
                        "#d9f0a3",
                        2,
                        "#78c679",
                        3,
                        "#31a354",
                        4,
                        "#006837",
                        5,
                        "#004529",
                        "#f7fcf5"
                    ],
                    "fill-opacity": 0.3
                },
                "outlineLayerStyle": {
                    "line-color": [
                        "case",
                        [
                            "boolean",
                            [
                                "feature-state",
                                "highlighted"
                            ],
                            false
                        ],
                        "#ff0000",
                        "#fce700"
                    ],
                    "line-width": [
                        "case",
                        [
                            "boolean",
                            [
                                "feature-state",
                                "highlighted"
                            ],
                            false
                        ],
                        3,
                        1
                    ],
                    "line-opacity": 1
                }
            },
            "visible": false,
            "zIndex": 2,
            "apiName": "getContractedLandByName",
            "clickable": true
        }
    ]
}